<Project>

  <!-- Propriedades comuns a todos os projetos Aedis. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Metadados de pacote (aplicados aos projetos publicáveis). -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>Aedis</Authors>
    <Company>Aedis</Company>
    <Product>Aedis</Product>
    <PackageProjectUrl>https://aedis.build</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aedis-build/aedis-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>aedis;dotnet;ddd;cqrs;event-driven;cloud-portable;secure-by-construction</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Os analyzers do próprio Aedis valem para o código do framework (src/), fora o projeto dos analyzers e os
       modelos de template. Testes ficam de fora: comparam valores de teste e não são código entregue. -->
  <PropertyGroup>
    <_AedisProjectPath>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</_AedisProjectPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Aedis.Analyzers' And '$(MSBuildProjectName)' != 'Aedis.Templates' And $(_AedisProjectPath.StartsWith('src/')) And !$(_AedisProjectPath.Contains('/templates/'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Aedis.Analyzers/Aedis.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Build determinístico em CI (supply-chain trust). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
